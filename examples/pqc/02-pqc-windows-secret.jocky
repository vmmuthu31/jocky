// SCENARIO: PQC Windows Evidence — Secret Classification
// USE CASE: Quantum-safe evidence from Windows host in classified network segment
// WARRANT: IT Act 2000 §69 — National Security (Secret)
// TARGET: Windows 11 workstation in classified network

forensic session {
    target: "172.16.50.10";
    warrant: "NTRO-2026-NATSEC-0005";
    collect {
        registry: HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\Run,
        registry: HKLM\SYSTEM\CurrentControlSet\Services,
        memory: process "lsass.exe",
        disk: mft_parse,
        network: active_connections
    };
    encrypt ml_kem(key: hsm_derived);   // Post-quantum: ML-KEM-768 (NIST FIPS 203)
    transmit via: "wss://pqc-forensics.ntro.gov.in/telemetry";
}
