// SCENARIO: LSASS Credential Dump Detection
// USE CASE: Detect Mimikatz / credential harvesting against lsass.exe
// WARRANT: IT Act 2000 §69 — Cyber Crime Investigation
// TARGET: Windows Active Directory Domain Controller

forensic session {
    target: "10.0.0.5";
    warrant: "NTRO-2026-CYBER-0078";
    collect {
        memory: process "lsass.exe",
        memory: process "werfault.exe",
        memory: process "comsvcs.dll",
        registry: HKLM\SYSTEM\CurrentControlSet\Control\Lsa,
        registry: HKLM\SYSTEM\CurrentControlSet\Control\SecurityProviders\WDigest,
        disk: prefetch,
        disk: mft_parse,
        network: active_connections
    };
    encrypt aes256(key: hsm_derived);
    transmit via: "wss://forensics-gw.ntro.gov.in/telemetry";
}
